# HTTP server port the MCP listener binds to
PORT=3333

# Base URL of the LettrLabs public API the MCP forwards to
# dev:  https://app-dev.lettrlabs.com
# qat:  https://app-qat.lettrlabs.com
# uat:  https://app-uat.lettrlabs.com
# prod: https://app.lettrlabs.com
LETTRLABS_API_BASE_URL=https://app-dev.lettrlabs.com

# Structured-log service name surfaced in App Insights / Log Analytics
OTEL_SERVICE_NAME=lettrlabs-publicapi-mcp

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Time-window (seconds) for MCP-layer write-tool dedupe
DEDUPE_WINDOW_SECONDS=60

# Max entries in the dedupe LRU cache
DEDUPE_CACHE_SIZE=1000
